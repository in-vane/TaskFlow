{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r --if-present test",
    "typecheck": "corepack pnpm -r typecheck",
    "dev:frontend": "corepack pnpm --filter @taskflow/frontend dev --host 0.0.0.0 --port 5173",
    "dev:api": "corepack pnpm --filter @taskflow/api dev",
    "dev:worker": "corepack pnpm --filter @taskflow/worker dev",
    "dev:compose": "docker compose -f compose.yaml -f compose.dev.yaml --profile tools up --build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^6.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
